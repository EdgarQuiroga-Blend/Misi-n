# ─────────────────────────────────────────────
#  HPG OpenSearch — Variables de entorno
#  Copia este archivo como .env y ajusta valores
#  NUNCA subas .env al repositorio
# ─────────────────────────────────────────────

# OpenSearch
OPENSEARCH_HOST=http://localhost:9200

# JVM Heap (ajustar según RAM disponible)
# Recomendado: 512m para desarrollo, 1g para uso real
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Dashboards
DASHBOARDS_PORT=5601
